{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-case-helper-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*", "/mcp", "/health"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
